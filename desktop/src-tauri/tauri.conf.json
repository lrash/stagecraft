{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Stagecraft",
  "version": "2.0.0",
  "identifier": "local.stagecraft.desktop",
  "build": { "frontendDist": ["../../idea-walkthrough/index.html"] },
  "app": {
    "withGlobalTauri": true,
    "windows": [],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; connect-src ipc: http://ipc.localhost; object-src 'none'; base-uri 'none'",
      "dangerousDisableAssetCspModification": ["style-src"]
    }
  },
  "bundle": {
    "active": true,
    "targets": ["appimage", "deb"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"],
    "createUpdaterArtifacts": false,
    "category": "Productivity",
    "shortDescription": "Walk an idea through seven stages on local models",
    "linux": { "deb": { "depends": [] } },
    "windows": { "nsis": { "installMode": "currentUser" } }
  }
}
